# HTTPS is required: browsers only allow screen sharing and the microphone on secure origins.

{$ASKY_HOST} {
	# public: the landing page is open; the app itself gates everything else
	# (signed workspace cookie: event code for the audience, password for the presenter)
	reverse_proxy asky:3210
}

{$ERP_HOST} {
	# ERPNext has its own login
	reverse_proxy frontend:8080
}
