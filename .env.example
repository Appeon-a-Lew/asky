# Everything is optional — asky runs fully offline with heuristics, rules and
# browser speech. Each key upgrades one part. Copy to .env.local.

# Claude: question phrasing, knowledge extraction, debrief, teach-back, vision, MCP descriptions
ANTHROPIC_API_KEY=
# ASKY_MODEL_SMART=claude-opus-5-5
# ASKY_MODEL_FAST=claude-haiku-4-5-20251001

# TypeSafe Jev (System-One model): interrupt / deviation decisions in 70–500 ms
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# ElevenLabs: agent = ears (mic, transcription, turn-taking), TTS = asky's voice.
# Create the agent with `pnpm setup:voice`.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
