# Everything is optional — asky runs fully offline with heuristics, rules and
# browser speech. Each key upgrades one part. Copy to .env.local.

# Claude: question phrasing, knowledge extraction, debrief, teach-back, vision, MCP descriptions
ANTHROPIC_API_KEY=
# ASKY_MODEL_SMART=claude-opus-5-5
# ASKY_MODEL_FAST=claude-haiku-4-5-20251001

# TypeSafe Jev (System-One model): interrupt / deviation decisions in 70–500 ms
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# ElevenLabs: agent = ears (mic, transcription, turn-taking), TTS = asky's voice.
# Create the agent with `pnpm setup:voice`.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ERPNext (real-app showcase, vision only) — defaults match frappe_docker's pwd.yml
# ERPNEXT_URL=http://localhost:8080
# where the browser reaches ERPNext, if different (asky in Docker next to it): links and "Open ERPNext"
# ERPNEXT_PUBLIC_URL=https://erp.example.com

# Public demo (leave unset locally: everything is one open workspace, as before)
# ASKY_SECRET=<random, signs the workspace cookie>       — turns on gating
# ASKY_EVENT_CODE=asky-1234                               — audience: code → private workspace
# ASKY_PRESENTER_PASSWORD=...                             — /presenter → the main workspace
# ASKY_WORKSPACE_TTL_HOURS=6  ASKY_MAX_WORKSPACES=60  ASKY_VISITOR_LLM_CALLS=150
# ASKY_VISITOR_TTS_CHARS=20000  ASKY_VISITOR_VOICE_SEATS=4
# ERPNEXT_USER=Administrator
# ERPNEXT_PASSWORD=admin
